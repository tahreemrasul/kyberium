# Copy to backend/.env for local development. Never commit real values.

# --- Gemini on Vertex AI -------------------------------------------------------
# "vertex" uses Application Default Credentials (gcloud auth application-default login
# locally; the Cloud Run service account in production). "off" = labelled demo mode.
AI_BACKEND=vertex
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-2.5-flash
# GEMINI_COMPOSER_MODEL=gemini-2.5-pro   # optional: stronger model for outfit composition
GEMINI_TIMEOUT_S=45
GEMINI_MAX_RETRIES=2
# rules = fall back to the clearly labelled rule-based matcher if Gemini fails; none = return a retryable error
COMPOSER_FALLBACK=rules

# --- Persistence --------------------------------------------------------------
# local = JSON + files under LOCAL_DATA_DIR; gcp = Firestore + Cloud Storage
STORAGE_BACKEND=local
LOCAL_DATA_DIR=.data
# FIRESTORE_DATABASE=(default)
# GCS_BUCKET=your-bucket-name

# --- Fashion knowledge retrieval (optional) ------------------------------------
# none | local (bundled original styling cards) | vector (future adapter)
FASHION_KNOWLEDGE_BACKEND=local
# FASHION_KNOWLEDGE_PATH=/path/to/styling_principles.json

# --- HTTP ---------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_BYTES=8388608
